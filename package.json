    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
